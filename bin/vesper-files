#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-or-later
# Copyright (C) 2026 Daniele Deplano (RedRider21). Parte di Vesper.
# vesper-files - file manager di Vesper.
#   vesper-files [CARTELLA]     finestra di gestione file
#   vesper-files --desktop      disegna sfondo e icone del desktop
# --- ambiente comune (pacchetto Python, dati, interprete) ---
_self=$(readlink -f "$0" 2>/dev/null || echo "$0"); _d=$(dirname "$_self")
for _e in "$_d/env.sh" "$(dirname "$_d")/lib/vesper/env.sh" \
          /usr/local/lib/vesper/env.sh /usr/lib/vesper/env.sh; do
  [ -r "$_e" ] && { . "$_e"; break; }
done
[ -n "${VESPER_PY:-}" ] || { echo "vesper-files: python3 non disponibile" >&2; exit 1; }
# Avvio "caldo": se il servizio gira, apre lui la FINESTRA (niente re-import).
# Il desktop (--desktop) resta un processo suo: disegna sfondo e icone e deve
# vivere quanto la sessione. Se il servizio non c'e', si prosegue qui sotto.
case "${1:-}" in
  --desktop) ;;
  *) if command -v vesper-launch >/dev/null 2>&1; then
       vesper-launch files "$@" && exit 0
     fi ;;
esac
exec "$VESPER_PY" -m vesper.filemanager "$@"
