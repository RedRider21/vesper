echo "=== Interfacce ==="
ip a 2>/dev/null || ifconfig
echo
echo "=== Routing ==="
ip r 2>/dev/null || route -n
echo
echo "=== DNS ==="
cat /etc/resolv.conf 2>/dev/null
echo
echo "=== Ping 1.1.1.1 ==="
ping -c2 -W2 1.1.1.1 2>&1 | tail -3
echo
printf "Premi invio per chiudere "; read junk
