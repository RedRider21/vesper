# Vesper - stato rete (per menu Openbox / Centro di Controllo).

# Gli strumenti di sistema stampano messaggi TRADOTTI: qui se ne legge
# l'output, quindi serve la lingua neutra o il parsing non trova nulla.
# Messaggi tradotti (it/en/fr/es/de). Senza i18n.sh restano in italiano.
vesper_t() { printf '%s\n' "${2:-$1}"; }
_vt_self=$(readlink -f "$0" 2>/dev/null || echo "$0"); _vt_d=$(dirname "$_vt_self")
for _i in "$_vt_d/i18n.sh" "$(dirname "$_vt_d")/lib/vesper/i18n.sh" \
          /usr/local/lib/vesper/i18n.sh /usr/lib/vesper/i18n.sh; do
  [ -r "$_i" ] && { . "$_i"; break; }
done
unset _i _vt_self _vt_d

LC_ALL=C
LANG=C
export LC_ALL LANG
echo "=== $(vesper_t cli.net.ifaces Interfacce) ==="
ip a 2>/dev/null || ifconfig
echo
echo "=== $(vesper_t cli.net.routing Routing) ==="
ip r 2>/dev/null || route -n
echo
echo "=== $(vesper_t cli.net.dns DNS) ==="
cat /etc/resolv.conf 2>/dev/null
echo
echo "=== $(vesper_t cli.net.ping Ping) 1.1.1.1 ==="
ping -c2 -W2 1.1.1.1 2>&1 | tail -3
echo
printf "%s " "$(vesper_t cli.press_enter 'Premi invio per chiudere')"; read junk
