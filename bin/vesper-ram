# vesper-ram - dove va la memoria: quanto Vesper, quanto il resto del sistema.
#
#   vesper-ram            riepilogo
#   vesper-ram --tutto    elenca anche i processi non di Vesper
# --- ambiente comune (pacchetto Python, dati, interprete) ---
_self=$(readlink -f "$0" 2>/dev/null || echo "$0"); _d=$(dirname "$_self")
for _e in "$_d/env.sh" "$(dirname "$_d")/lib/vesper/env.sh" \
          /usr/local/lib/vesper/env.sh /usr/lib/vesper/env.sh; do
  [ -r "$_e" ] && { . "$_e"; break; }
done
[ -n "${VESPER_PY:-}" ] || { echo "vesper-ram: python3 non disponibile" >&2; exit 1; }
exec "$VESPER_PY" -m vesper.raminfo "$@"
