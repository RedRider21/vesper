#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-or-later
# Copyright (C) 2026 Daniele Deplano (RedRider21). Parte di Vesper.
# Vesper - gestione schermi via xrandr (per l'applet del pannello).
#
# Uso:
#   vesper-screens outputs           "NOME<TAB>connected|disconnected<TAB>primary|-<TAB>WxH"
#   vesper-screens modes NOME        risoluzioni disponibili per l'output
#   vesper-screens mirror            duplica su tutti gli output connessi
#   vesper-screens extend            estende (primario + altri a destra)
#   vesper-screens only NOME         solo quell'output (gli altri spenti)
#   vesper-screens mode NOME WxH     imposta risoluzione
#   vesper-screens primary NOME      imposta output primario
#   vesper-screens autostart         all'avvio: estende se sono connessi 2+ monitor
#
# xrandr agisce sulla sessione X dell'utente: nessun privilegio necessario.
#
# Dopo ogni cambio di disposizione il desktop si riassesta AL VOLO, senza
# riavviare nulla:
#   1) viene toccato il file di refresh (pannello e Centro di Controllo lo
#      ascoltano e riposizionano barre e finestre sul monitor attivo);
#   2) si riapplicano sfondo+accent (vesper-profile apply).
# Prima il cambio schermo lasciava barre e finestre sul monitor spento (xrandr
# --off/--primary spesso NON scatena "monitors-changed" di GTK).

# Gli strumenti di sistema stampano messaggi TRADOTTI: qui se ne legge
# l'output, quindi serve la lingua neutra o il parsing non trova nulla.
LC_ALL=C
LANG=C
export LC_ALL LANG

LOG=/tmp/vesper-screens.log
REFRESH="$HOME/.cache/vesper/screens-refresh"

connected() { xrandr --query 2>/dev/null | awk '/ connected/{print $1}'; }
primary_out() { xrandr --query 2>/dev/null | awk '/ connected primary/{print $1; exit}'; }
# Rotazione corrente di un output: normal | left | right | inverted.
# xrandr la scrive come parola SUBITO DOPO la geometria, prima della parentesi
# ("HDMI-1 connected 1080x1920+0+0 left (normal left ...)"); se non c'e', e'
# normale. Serve a NON perdere l'orientamento quando si riapplica la
# disposizione (schermo verticale che tornava orizzontale da solo).
cur_rot() {
  xrandr --query 2>/dev/null | awk -v o="$1" '
    $1==o {
      for (i=1; i<=NF; i++) {
        if ($i ~ /^[0-9]+x[0-9]+\+/) {
          r = $(i+1)
          if (r=="left" || r=="right" || r=="inverted") { print r; exit }
          print "normal"; exit
        }
      }
      print "normal"; exit
    }'
}

# Risoluzione corrente di un output (es. 1920x1080) oppure vuota.
cur_res() {
  xrandr --query 2>/dev/null | awk -v o="$1" '
    $1==o { for(i=1;i<=NF;i++) if($i ~ /^[0-9]+x[0-9]+\+/) { split($i,a,"+"); print a[1]; exit } }'
}

reload_desktop() {
  mkdir -p "$(dirname "$REFRESH")" 2>/dev/null || true
  : > "$REFRESH" 2>/dev/null || true
  # Riapplica sfondo+accent: il desktop si riassesta sulla nuova disposizione.
  # (prima qui c'era "vesper-tool apply", comando che in Vesper non esiste:
  # dopo un cambio schermo lo sfondo non veniva più ridisegnato)
  command -v vesper-profile >/dev/null 2>&1 && vesper-profile apply >/dev/null 2>&1 &
}

# Estende il desktop: l'output attualmente primario resta primario, gli altri
# si dispongono a destra. Un solo comando xrandr (atomico).
extend_all() {
  base=$(primary_out); [ -z "$base" ] && base=$(connected | head -1)
  [ -n "$base" ] || return 1
  prev="$base"
  set -- --output "$base" --auto --primary --rotate "$(cur_rot "$base")"
  for o in $(connected); do
    [ "$o" = "$prev" ] && continue
    # --rotate: senza, uno schermo messo in verticale tornerebbe orizzontale
    # a ogni riapplicazione della disposizione
    set -- "$@" --output "$o" --auto --rotate "$(cur_rot "$o")" --right-of "$prev"
    prev="$o"
  done
  xrandr "$@" 2>>"$LOG"
  return 0
}

# Duplica su tutti gli output connessi (stessa risoluzione del primario, cosi'
# su monitor con risoluzioni diverse il contenuto e' davvero lo stesso).
mirror_all() {
  base=$(primary_out); [ -z "$base" ] && base=$(connected | head -1)
  [ -n "$base" ] || return 1
  res=$(cur_res "$base")
  if [ -n "$res" ]; then
    set -- --output "$base" --mode "$res" --primary
    for o in $(connected); do
      [ "$o" = "$base" ] && continue
      set -- "$@" --output "$o" --mode "$res" --same-as "$base"
    done
    xrandr "$@" 2>>"$LOG" && return 0
    echo "mirror: risoluzione $res non supportata ovunque, ripiego su --auto" >> "$LOG"
  fi
  set -- --output "$base" --auto --primary
  for o in $(connected); do
    [ "$o" = "$base" ] && continue
    set -- "$@" --output "$o" --auto --same-as "$base"
  done
  xrandr "$@" 2>>"$LOG"
}

# --- Disposizione e coperchio ----------------------------------------------
# Preferenza dell'utente: estendi (predefinito) o duplica.
# Il predefinito e' "extend" perche' su un computer normale collegare un
# secondo schermo significa AMPLIARE la scrivania; chi collega un proiettore
# sceglie "duplica" dal Centro di Controllo o con:  vesper-screens set-policy mirror
CONF="$HOME/.config/vesper/screens.conf"
screen_policy() {
  pol=extend
  [ -r "$CONF" ] && . "$CONF" 2>/dev/null
  case "${VESPER_SCREEN_POLICY:-${NXS_SCREEN_POLICY:-$pol}}" in
    mirror) echo mirror ;;
    *)      echo extend ;;
  esac
}

# Pannello LCD del portatile: eDP / LVDS / DSI (gli esterni sono HDMI/DP/VGA).
internal_out() { connected | grep -iE '^(eDP|LVDS|DSI)' | head -1; }

# Stato del coperchio via ACPI (open|closed|unknown). Nessun demone acpid:
# leggiamo direttamente il file esposto dal kernel.
lid_state() {
  # Override per prove e diagnostica.
  [ -n "${VESPER_LID_STATE:-${NXS_LID_STATE:-}}" ] && {
      echo "${VESPER_LID_STATE:-$NXS_LID_STATE}"; return; }
  for f in /proc/acpi/button/lid/*/state; do
    [ -r "$f" ] || continue
    awk '{print $NF}' "$f" 2>/dev/null | head -1
    return
  done
  echo unknown
}

# Applica la disposizione giusta per la situazione CORRENTE (numero di monitor,
# policy, coperchio). E' il cuore chiamato sia all'avvio sia dal watcher.
apply_policy() {
  n=$(connected | wc -l)
  intern=$(internal_out)
  lid=$(lid_state)

  # Coperchio CHIUSO con un monitor esterno collegato: spegni il pannello
  # interno e passa tutto sull'esterno. Senza questo il desktop restava steso
  # su uno schermo spento e sull'esterno si vedeva solo una porzione, senza
  # barra (era il sintomo "si vede solo una parte centrale").
  if [ "$lid" = closed ] && [ -n "$intern" ] && [ "$n" -ge 2 ]; then
    ext=$(connected | grep -vxF "$intern" | head -1)
    if [ -n "$ext" ]; then
      set -- --output "$ext" --auto --primary --rotate "$(cur_rot "$ext")"
      for o in $(connected); do
        [ "$o" = "$ext" ] && continue
        set -- "$@" --output "$o" --off
      done
      xrandr "$@" 2>>"$LOG"
      return 0
    fi
  fi

  # Un solo schermo: assicurati che sia acceso e primario (un output connesso
  # ma senza CRTC non viene disegnato da X: resta la splash del kernel).
  if [ "$n" -lt 2 ]; then
    one=$(connected | head -1)
    [ -n "$one" ] && xrandr --output "$one" --auto --primary \
        --rotate "$(cur_rot "$one")" 2>>"$LOG"
    return 0
  fi

  case "$(screen_policy)" in
    mirror) mirror_all ;;
    *)      extend_all ;;
  esac
}

case "${1:-}" in
  outputs)
    xrandr --query 2>/dev/null | awk '
      / connected/ {
        name=$1; prim=($3=="primary"||$4=="primary")?"primary":"-";
        res="-";
        for(i=3;i<=NF;i++) if($i ~ /^[0-9]+x[0-9]+\+/){split($i,a,"+"); res=a[1]; break}
        print name"\tconnected\t"prim"\t"res
      }
      / disconnected/ { print $1"\tdisconnected\t-\t-" }'
    ;;

  modes)
    xrandr --query 2>/dev/null | awk -v o="$2" '
      $1==o {f=1; next}
      / connected/||/ disconnected/ {f=0}
      f && $1 ~ /^[0-9]+x[0-9]+$/ {print $1}'
    ;;

  mirror)
    mirror_all || exit 1
    reload_desktop
    ;;

  extend)
    extend_all
    reload_desktop
    ;;

  only)
    keep="$2"; [ -n "$keep" ] || exit 1
    set -- --output "$keep" --auto --primary
    for o in $(connected); do
      [ "$o" = "$keep" ] && continue
      set -- "$@" --output "$o" --off
    done
    xrandr "$@" 2>>"$LOG"
    reload_desktop
    ;;

  mode)
    [ -n "$2" ] && [ -n "$3" ] || exit 1
    xrandr --output "$2" --mode "$3" 2>>"$LOG"
    reload_desktop
    ;;

  primary)
    [ -n "$2" ] || exit 1
    xrandr --output "$2" --primary 2>>"$LOG"
    reload_desktop
    ;;

  rotation)
    # Stampa l'orientamento corrente di un output (o di tutti).
    if [ -n "${2:-}" ]; then
      cur_rot "$2"
    else
      for o in $(connected); do printf '%s\t%s\n' "$o" "$(cur_rot "$o")"; done
    fi
    ;;

  rotate)
    # Ruota uno schermo: utile con un monitor montato in VERTICALE.
    #   vesper-screens rotate HDMI-1 left
    # normal = orizzontale, left/right = verticale (a seconda di come e'
    # girato il monitor), inverted = capovolto.
    [ -n "${2:-}" ] || { echo "uso: vesper-screens rotate OUTPUT {normal|left|right|inverted}" >&2; exit 2; }
    case "${3:-}" in
      normal|left|right|inverted) ;;
      *) echo "orientamento non valido: ${3:-} (normal|left|right|inverted)" >&2; exit 2 ;;
    esac
    xrandr --output "$2" --rotate "$3" 2>>"$LOG" || exit 1
    # Dopo una rotazione cambiano le dimensioni dello schermo: barre e finestre
    # vanno riposizionate, e lo sfondo ridisegnato.
    reload_desktop
    ;;

  autostart)
    # All'avvio applica la disposizione secondo la policy (default: duplica).
    # CRUCIALE: un output connesso ma senza CRTC non viene MAI disegnato da X e
    # sul monitor esterno resta visibile la splash del kernel. Qui lo attiviamo.
    # Nessun refresh: desktop/pannello partono dopo e si posizionano gia'
    # sulla configurazione finale.
    apply_policy
    ;;

  policy)
    # Riapplica la disposizione corrente (usato dal watcher a ogni cambiamento).
    apply_policy
    reload_desktop
    ;;

  lid)
    # Stampa lo stato del coperchio (open|closed|unknown) - diagnostica.
    lid_state
    ;;

  get-policy)
    # Stampa la policy corrente (mirror|extend) - usata dal Centro di Controllo.
    screen_policy
    ;;

  set-policy)
    # set-policy mirror|extend - salva la preferenza dell'utente.
    case "${2:-}" in
      mirror|extend)
        mkdir -p "$(dirname "$CONF")" 2>/dev/null || true
        printf 'VESPER_SCREEN_POLICY=%s\n' "$2" > "$CONF"
        apply_policy; reload_desktop ;;
      *) echo "uso: vesper-screens set-policy {mirror|extend}" >&2; exit 2 ;;
    esac
    ;;

  *)
    echo "uso: vesper-screens {outputs|modes NOME|mirror|extend|only NOME|mode NOME WxH|primary NOME|autostart|policy|set-policy mirror|extend|lid}" >&2
    exit 2 ;;
esac
