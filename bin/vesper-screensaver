#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-or-later
# Copyright (C) 2026 Daniele Deplano (RedRider21). Parte di Vesper.
# vesper-screensaver - salvaschermo animato (GTK3 + Cairo), con blocco schermo.
#
#   vesper-screensaver [stile]
#   stili: nebula matrix starfield aurora grid sparkles orbits logo
# Senza argomenti usa lo stile salvato in ~/.config/vesper/screensaver.conf.
# --- ambiente comune (pacchetto Python, dati, interprete) ---
_self=$(readlink -f "$0" 2>/dev/null || echo "$0"); _d=$(dirname "$_self")
for _e in "$_d/env.sh" "$(dirname "$_d")/lib/vesper/env.sh" \
          /usr/local/lib/vesper/env.sh /usr/lib/vesper/env.sh; do
  [ -r "$_e" ] && { . "$_e"; break; }
done
[ -n "${VESPER_PY:-}" ] || { echo "vesper-screensaver: python3 non disponibile" >&2; exit 1; }
exec "$VESPER_PY" -m vesper.screensaver "$@"
