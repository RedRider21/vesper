#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-or-later
# Copyright (C) 2026 Daniele Deplano (RedRider21). Parte di Vesper.
#
# vesper-session - avvia la sessione desktop Vesper.
# È l'Exec del file /usr/share/xsessions/vesper.desktop: lo esegue il display
# manager (LightDM, SDDM, GDM, ...) quando si scegle "Vesper" al login. Si può
# anche lanciare a mano da .xinitrc con `exec vesper-session`.
#
# Cosa fa, in ordine:
#   1. prepara l'ambiente (percorsi, XDG_CURRENT_DESKTOP=Vesper, D-Bus);
#   2. al primo avvio crea la configurazione utente in ~/.config/vesper
#      (rc.xml e menu del window manager) SENZA toccare un'eventuale
#      configurazione Openbox già esistente dell'utente;
#   3. applica il preset di aspetto (accent, sfondo, icone);
#   4. avvia i componenti: desktop (sfondo+icone), pannello, servizi;
#   5. esegue l'autostart XDG (~/.config/autostart, /etc/xdg/autostart);
#   6. passa il controllo al gestore finestre in primo piano (Openbox, oppure
#      marco/metacity se si vogliono le decorazioni vere di Mint): quando
#      questo esce, la sessione termina.
set -u

# --- ambiente comune (pacchetto Python, dati, interprete) ---
_self=$(readlink -f "$0" 2>/dev/null || echo "$0"); _d=$(dirname "$_self")
for _e in "$_d/env.sh" "$(dirname "$_d")/lib/vesper/env.sh" \
          /usr/local/lib/vesper/env.sh /usr/lib/vesper/env.sh; do
  [ -r "$_e" ] && { . "$_e"; break; }
done

# Siamo NOI la sessione: qui l'identificazione del desktop si impone.
XDG_CURRENT_DESKTOP=Vesper
XDG_SESSION_DESKTOP=vesper
export XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP

# Marcatore di sessione. Lo esporta SOLO questo script, ed e' cio' che
# autorizza Vesper a toccare le impostazioni dell'utente condivise con gli
# altri desktop (tema GTK, decorazioni, scorciatoie di marco). Un comando
# `vesper-*` lanciato dentro XFCE o Cinnamon non lo ha, e li' non tocca nulla.
VESPER_SESSION=1
export VESPER_SESSION

CONF="${XDG_CONFIG_HOME:-$HOME/.config}/vesper"
CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/vesper"
mkdir -p "$CONF" "$CACHE" 2>/dev/null || true
LOG="$CACHE/session.log"

# --- uscita dalla sessione ------------------------------------------------
# `vesper-session --logout` termina la sessione SENZA sapere quale gestore
# finestre sta girando: manda TERM a questo stesso script, che ferma il WM e
# ripristina il desktop precedente. Prima si faceva `openbox --exit`, che non
# fa nulla se il gestore e' marco o metacity: era il motivo per cui il logout
# sembrava non funzionare.
if [ "${1:-}" = "--logout" ] || [ "${1:-}" = "--esci" ]; then
  PIDFILE="$CACHE/session.pid"
  PID=$(head -1 "$PIDFILE" 2>/dev/null || echo "")
  if [ -n "$PID" ] && [ -d "/proc/$PID" ] &&
     grep -qa "vesper-session" "/proc/$PID/cmdline" 2>/dev/null; then
    kill -TERM "$PID" 2>/dev/null && exit 0
  fi
  # Nessuna sessione Vesper viva: non si chiude la sessione di qualcun altro.
  echo "vesper-session: nessuna sessione Vesper in corso (sessione:" \
       "${DESKTOP_SESSION:-${XDG_SESSION_DESKTOP:-sconosciuta}}):" \
       "esci dal menu del desktop che stai usando." >&2
  exit 1
fi

# Bus di SESSIONE: serve alle notifiche, al Bluetooth (obexd) e a molte app.
# Se non c'è, ci riavviamo dentro dbus-run-session (una volta sola: la guardia
# VESPER_DBUS evita il loop).
if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] && [ -z "${VESPER_DBUS:-}" ] \
   && command -v dbus-run-session >/dev/null 2>&1; then
  VESPER_DBUS=1
  export VESPER_DBUS
  exec dbus-run-session -- "$0" "$@"
fi

exec >>"$LOG" 2>&1

# PID di questo script: lo legge vesper-logout per terminare la sessione
# qualunque sia il gestore finestre.
echo $$ > "$CACHE/session.pid"

# Pulizia una tantum: le versioni fino alla 0.4.1 scrivevano il blocco
# dell'autostart dentro ~/.config/openbox/autostart, che è dell'utente. Si
# migra nel file di Vesper e si toglie di là.
"$VESPER_PY" -m vesper.sessionstate migra 2>&1 || true

# Fotografia del desktop PRECEDENTE (tema GTK, .gtkrc-2.0, gsettings delle
# decorazioni e delle scorciatoie): all'uscita si rimette tutto com'era, cosi'
# chi torna in XFCE o in Cinnamon ritrova il suo desktop.
"$VESPER_PY" -m vesper.sessionstate salva 2>&1 || true

# Uscita ordinata: ferma il gestore finestre, ripristina il desktop di prima,
# pulisce i file di stato. Vale per il logout, per un TERM del display manager
# e per la fine naturale della sessione.
_vesper_uscita() {
  [ -n "${WM_PID:-}" ] && kill -TERM "$WM_PID" 2>/dev/null || true
  # L'avvio "caldo" e' figlio di questo script ma NON riceve il TERM del
  # logout: se il display manager tiene in piedi lo stesso server X, il
  # servizio sopravviveva alla sessione e la successiva se lo ritrovava gia'
  # in ascolto, con i moduli e la lingua di prima.
  command -v vesper-launcherd >/dev/null 2>&1 && \
    vesper-launcherd --stop >/dev/null 2>&1 || true
  "$VESPER_PY" -m vesper.sessionstate ripristina 2>&1 || true
  rm -f "$CACHE/session.pid" "$CACHE/wm.pid" 2>/dev/null || true
  echo "=== sessione Vesper terminata $(date) ==="
}
trap '_vesper_uscita; exit 0' TERM INT HUP
echo "=== sessione Vesper avviata $(date) ==="

# --- 2. configurazione del window manager, solo se manca -------------------
# Vesper tiene il PROPRIO rc.xml in ~/.config/vesper e avvia Openbox con
# --config-file: così non tocca ~/.config/openbox, e chi usa Openbox "nudo"
# in un'altra sessione se lo ritrova intatto.
RC="$CONF/openbox-rc.xml"
MENU="$CONF/openbox-menu.xml"
# Il menu del tasto destro esiste in cinque lingue: si copia quello della
# lingua scelta (~/.config/vesper/lang), con ripiego sull'italiano.
VLANG=$(head -1 "$CONF/lang" 2>/dev/null || echo it)
for d in ${VESPER_DATA_DIRS:-} /usr/local/share/vesper /usr/share/vesper; do
  [ -d "$d/skel/openbox" ] || continue
  [ -f "$RC" ]   || cp "$d/skel/openbox/rc.xml" "$RC" 2>/dev/null
  if [ ! -f "$MENU" ]; then
    cp "$d/skel/openbox/openbox-menu.$VLANG.xml" "$MENU" 2>/dev/null ||
      cp "$d/skel/openbox/openbox-menu.xml" "$MENU" 2>/dev/null
  fi
  break
done
# Tutti i componenti che modificano rc.xml (margini del pannello, editor
# scorciatoie, tema finestre) devono scrivere QUESTO file.
[ -f "$RC" ] && { VESPER_RC_XML="$RC"; export VESPER_RC_XML; }

# Layout di tastiera, se l'utente ne ha scelto uno (~/.config/vesper/keyboard).
if [ -r "$CONF/keyboard" ] && command -v setxkbmap >/dev/null 2>&1; then
  setxkbmap $(head -1 "$CONF/keyboard") 2>/dev/null || true
fi

# --- 3. aspetto: accent, sfondo, tema icone del preset attivo --------------
# Prima si congeda un eventuale avvio "caldo" rimasto da una sessione
# precedente sullo stesso server X: e' nato con altri moduli e un'altra lingua.
command -v vesper-launcherd >/dev/null 2>&1 && \
  vesper-launcherd --stop >/dev/null 2>&1 || true
command -v vesper-profile >/dev/null 2>&1 && vesper-profile apply || true

# --- 4. componenti del desktop ---------------------------------------------
# Schermi: normalizza la disposizione PRIMA di disegnare qualcosa.
command -v vesper-screens >/dev/null 2>&1 && vesper-screens autostart || true

# Desktop (sfondo + icone) e pannello.
command -v vesper-files >/dev/null 2>&1 && vesper-files --desktop &
command -v vesper-panel >/dev/null 2>&1 && vesper-panel &

# Servizi di corredo, tutti best-effort: se mancano, la sessione parte comunque.
command -v vesper-audio-unmute >/dev/null 2>&1 && (sleep 2; vesper-audio-unmute) &
command -v vesper-clipboard >/dev/null 2>&1 && (sleep 1; vesper-clipboard daemon) &
# Avvio "caldo": un processo che tiene GTK e i moduli gia' importati, cosi' le
# finestre di Vesper si aprono senza ripagare gli import. Parte per ultimo
# (dopo pannello e desktop) e se manca non cambia nulla: i comandi ripiegano
# sull'avvio normale (piu' lento di circa mezzo secondo).
# Costa ~33 MiB di memoria: chi ha poca RAM lo spegne scrivendo "off" in
# ~/.config/vesper/launcher (o con: vesper-launch --off).
VLAUNCH=$(head -1 "$CONF/launcher" 2>/dev/null || echo on)
if [ "$VLAUNCH" != "off" ] && command -v vesper-launcherd >/dev/null 2>&1; then
  (sleep 3; vesper-launcherd) &
fi
command -v vesper-nightlight >/dev/null 2>&1 && (sleep 2; vesper-nightlight restore) &
# Demone notifiche: senza, notify-send è un no-op. Si prende il primo presente.
for n in dunst mako xfce4-notifyd; do
  command -v "$n" >/dev/null 2>&1 && { "$n" & break; }
done
# Agente PolicyKit: prompt grafici per i privilegi (installarne uno è opzionale).
for pk in lxpolkit lxqt-policykit-agent polkit-mate-authentication-agent-1 \
          polkit-gnome-authentication-agent-1 /usr/lib/policykit-1-gnome/polkit-gnome-authentication-agent-1; do
  command -v "$pk" >/dev/null 2>&1 && { "$pk" & break; }
done
# Composizione (angoli/trasparenze): la accende il preset se serve, qui no.

# Integrazione con le macchine virtuali (mouse e ridimensionamento automatico).
command -v VBoxClient-all >/dev/null 2>&1 && VBoxClient-all 2>/dev/null &
command -v spice-vdagent >/dev/null 2>&1 && spice-vdagent 2>/dev/null &

# --- 5. autostart XDG (le app che l'utente/la distro voglione all'avvio) ----
command -v vesper-autostart >/dev/null 2>&1 && (sleep 2; vesper-autostart) &
# Autostart NOSTRO (~/.config/vesper/autostart, lo scrive il Centro di
# Controllo): file di Vesper, non condiviso con gli altri desktop.
[ -r "$CONF/autostart" ] && (sleep 2; sh "$CONF/autostart") &

# --- 6. window manager in primo piano: la sessione vive quanto lui ---------
# Quale gestore finestre: la scelta sta in ~/.config/vesper/wm.
#   openbox   (predefinito) decorazioni di Vesper, coordinate col preset
#   marco     gestore finestre di MATE: usa i temi metacity-1, quindi disegna
#             le decorazioni VERE di Mint (Mint-Y, Mint-L, ...)
#   metacity  come sopra, versione GNOME storica
# Openbox non sa leggere quei temi (formato diverso), ed è il motivo per cui
# esiste questa scelta.
# La scelta la risolve Vesper: in "auto" preferisce marco/metacity, che sanno
# disegnare le decorazioni vere di Mint, e ripiega su Openbox se non ci sono.
WM=$(vesper-wm --risolto 2>/dev/null | tr -d ' \n')
case "$WM" in
  marco|metacity|openbox) ;;
  *) WM=openbox ;;
esac
# se il gestore scelto non c'è, si ripiega su quello che c'è
command -v "$WM" >/dev/null 2>&1 || WM=""
if [ -z "$WM" ]; then
  for c in openbox marco metacity; do
    command -v "$c" >/dev/null 2>&1 && { WM="$c"; break; }
  done
fi
if [ -z "$WM" ]; then
  echo "vesper-session: $(vesper_t cli.session.no_wm 'nessun gestore finestre trovato (serve openbox)')" >&2
  command -v xmessage >/dev/null 2>&1 && \
    xmessage -center "Vesper ha bisogno di un gestore finestre.
Installa il pacchetto 'openbox' e riprova." 2>/dev/null
  exit 1
fi
echo "gestore finestre: $WM"

# Il gestore finestre gira in BACKGROUND e la sessione lo aspetta: cosi'
# quando esce (logout, crash, --exit) questo script riprende il controllo ed
# esegue il ripristino. Con `exec` il ripristino non avverrebbe mai.
case "$WM" in
  openbox)
    # SEMPRE --config-file col rc.xml di Vesper: `openbox` nudo leggerebbe
    # ~/.config/openbox/rc.xml, cioè la configurazione Openbox dell'utente.
    if [ ! -f "$RC" ]; then
      for d in ${VESPER_DATA_DIRS:-} /usr/local/share/vesper /usr/share/vesper; do
        [ -f "$d/skel/openbox/rc.xml" ] && { cp "$d/skel/openbox/rc.xml" "$RC"; break; }
      done
    fi
    openbox --config-file "$RC" & WM_PID=$! ;;
  marco)     marco & WM_PID=$! ;;
  metacity)  metacity & WM_PID=$! ;;
esac
echo "$WM_PID" > "$CACHE/wm.pid"
wait "$WM_PID"
_vesper_uscita
exit 0
