#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-or-later
# Copyright (C) 2026 Daniele Deplano (RedRider21). Parte di Vesper.
# vesper-viewer - Visualizzatore di immagini (GTK3 + GdkPixbuf).
#
#   vesper-viewer [FILE o CARTELLA]
# --- ambiente comune (pacchetto Python, dati, interprete) ---
_self=$(readlink -f "$0" 2>/dev/null || echo "$0"); _d=$(dirname "$_self")
for _e in "$_d/env.sh" "$(dirname "$_d")/lib/vesper/env.sh" \
          /usr/local/lib/vesper/env.sh /usr/lib/vesper/env.sh; do
  [ -r "$_e" ] && { . "$_e"; break; }
done
[ -n "${VESPER_PY:-}" ] || { echo "vesper-viewer: python3 non disponibile" >&2; exit 1; }
# Avvio "caldo": se il servizio gira, apre lui la finestra (niente re-import).
if command -v vesper-launch >/dev/null 2>&1; then
  vesper-launch viewer "$@" && exit 0
fi
exec "$VESPER_PY" -m vesper.viewer "$@"
