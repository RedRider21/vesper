#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-or-later
# Copyright (C) 2026 Daniele Deplano (RedRider21). Parte di Vesper.
# vesper-wm - quale gestore finestre usa la sessione.
#
#   vesper-wm              mostra la scelta e cosa è disponibile
#   vesper-wm auto         preferisce le decorazioni Mint (predefinito)
#   vesper-wm openbox      decorazioni di Vesper, coordinate col preset
#   vesper-wm marco        decorazioni VERE di Mint (temi metacity-1)
#   vesper-wm metacity     come marco, versione GNOME storica
#
# Ha effetto al prossimo accesso (il gestore finestre si sceglie all'avvio
# della sessione). Openbox non sa leggere i temi di Mint: è il motivo per cui
# esiste questa scelta.
# --- ambiente comune (pacchetto Python, dati, interprete) ---
_self=$(readlink -f "$0" 2>/dev/null || echo "$0"); _d=$(dirname "$_self")
for _e in "$_d/env.sh" "$(dirname "$_d")/lib/vesper/env.sh" \
          /usr/local/lib/vesper/env.sh /usr/lib/vesper/env.sh; do
  [ -r "$_e" ] && { . "$_e"; break; }
done
[ -n "${VESPER_PY:-}" ] || { echo "vesper-wm: python3 non disponibile" >&2; exit 1; }

exec "$VESPER_PY" - "$@" <<'PY'
import shutil
import sys

from vesper.profiles import model

try:
    from vesper.i18n import t as _t
except Exception:                       # noqa: BLE001
    def _t(chiave, **kw):               # ripiego: mostra la chiave
        return chiave

if len(sys.argv) > 1 and sys.argv[1] in ("--risolto", "--resolved"):
    # lo usa vesper-session per sapere quale gestore avviare
    print(model.resolve_wm())
    raise SystemExit(0)

if len(sys.argv) > 1:
    scelto = model.set_wm(sys.argv[1])
    print(_t("cli.wm.chosen"), scelto)
    if scelto in ("marco", "metacity"):
        print(_t("cli.wm.decorations"),
              model.wm_theme_name() or _t("cli.wm.no_mint_theme"))
    print(_t("cli.wm.next_login"))
    raise SystemExit(0)

attuale = model.get_wm()
print(_t("cli.wm.choice"), attuale, "->", _t("cli.wm.in_use"), model.resolve_wm())
for wm in model.WM_SUPPORTED:
    if wm == "auto":
        print("  %-9s %-15s %s" % ("auto", "-", _t("cli.wm.auto_note")))
        continue
    stato = (_t("cli.wm.available") if shutil.which(wm)
             else _t("cli.wm.not_installed"))
    note = (_t("cli.wm.note_openbox") if wm == "openbox"
            else _t("cli.wm.note_mint"))
    print("  %-9s %-15s %s" % (wm, stato, note))
PY
