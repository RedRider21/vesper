<?xml version="1.0" encoding="UTF-8"?>
<!-- Menu root di Openbox: compare col TASTO DESTRO sul DESKTOP (il desktop di
     Vesper inoltra il clic al window manager). Raccoglie le azioni più
     frequenti, così non serve aprire il menu dal pannello. -->
<openbox_menu xmlns="http://openbox.org/3.4/menu">

  <menu id="vesper-tools" label="Herramientas">
    <item label="Terminal"><action name="Execute"><command>vesper-terminal</command></action></item>
    <item label="Gestor de archivos"><action name="Execute"><command>vesper-files</command></action></item>
    <item label="Portapapeles (historial)"><action name="Execute"><command>vesper-clipboard menu</command></action></item>
    <item label="Filtro de luz azul (on/off)"><action name="Execute"><command>vesper-nightlight toggle</command></action></item>
    <item label="Atajos de teclado"><action name="Execute"><command>vesper-control-center hotkey</command></action></item>
    <item label="Centro de control"><action name="Execute"><command>vesper-control-center</command></action></item>
  </menu>

  <menu id="vesper-screen" label="Pantalla">
    <item label="Bloquear la pantalla"><action name="Execute"><command>vesper-screensaver</command></action></item>
    <item label="Captura de pantalla (completa)"><action name="Execute"><command>vesper-screenshot full 1</command></action></item>
    <item label="Captura de pantalla (área)"><action name="Execute"><command>vesper-screenshot area 0</command></action></item>
    <separator/>
    <item label="Disposición de pantallas"><action name="Execute"><command>vesper-control-center schermi</command></action></item>
  </menu>

  <menu id="vesper-look" label="Aspecto">
    <item label="Ajustes (color, fondo, iconos)"><action name="Execute"><command>vesper-profile</command></action></item>
    <item label="Fondo del escritorio"><action name="Execute"><command>vesper-control-center sfondo</command></action></item>
    <item label="Skin del panel"><action name="Execute"><command>vesper-control-center aspetto</command></action></item>
  </menu>

  <menu id="root-menu" label="Vesper">
    <item label="Terminal"><action name="Execute"><command>vesper-terminal</command></action></item>
    <item label="Gestor de archivos"><action name="Execute"><command>vesper-files</command></action></item>
    <separator/>
    <menu id="vesper-tools"/>
    <menu id="vesper-screen"/>
    <menu id="vesper-look"/>
    <separator/>
    <item label="Recargar el gestor de ventanas"><action name="Reconfigure"/></item>
    <item label="Reiniciar el panel"><action name="Execute"><command>vesper-panel-restart</command></action></item>
    <separator/>
    <item label="Salir / Apagar…"><action name="Execute"><command>vesper-logout</command></action></item>
  </menu>

</openbox_menu>
