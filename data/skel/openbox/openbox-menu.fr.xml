<?xml version="1.0" encoding="UTF-8"?>
<!-- Menu root di Openbox: compare col TASTO DESTRO sul DESKTOP (il desktop di
     Vesper inoltra il clic al window manager). Raccoglie le azioni più
     frequenti, così non serve aprire il menu dal pannello. -->
<openbox_menu xmlns="http://openbox.org/3.4/menu">

  <menu id="vesper-tools" icon="@ICONE@/tools.svg" label="Outils">
    <item icon="@ICONE@/terminal.svg" label="Terminal"><action name="Execute"><command>vesper-terminal</command></action></item>
    <item icon="@ICONE@/files.svg" label="Gestionnaire de fichiers"><action name="Execute"><command>vesper-files</command></action></item>
    <item icon="@ICONE@/clipboard.svg" label="Presse-papiers (historique)"><action name="Execute"><command>vesper-clipboard menu</command></action></item>
    <item icon="@ICONE@/nightlight.svg" label="Filtre de lumière bleue (on/off)"><action name="Execute"><command>vesper-nightlight toggle</command></action></item>
    <item icon="@ICONE@/keyboard.svg" label="Raccourcis clavier"><action name="Execute"><command>vesper-control-center hotkey</command></action></item>
    <item icon="@ICONE@/control-center.svg" label="Centre de contrôle"><action name="Execute"><command>vesper-control-center</command></action></item>
  </menu>

  <menu id="vesper-screen" icon="@ICONE@/screen.svg" label="Écran">
    <item icon="@ICONE@/lock.svg" label="Verrouiller l'écran"><action name="Execute"><command>vesper-screensaver</command></action></item>
    <item icon="@ICONE@/screenshot.svg" label="Capture d'écran (tout l'écran)"><action name="Execute"><command>vesper-screenshot full 1</command></action></item>
    <item icon="@ICONE@/screenshot.svg" label="Capture d'écran (zone)"><action name="Execute"><command>vesper-screenshot area 0</command></action></item>
    <separator/>
    <item icon="@ICONE@/screen.svg" label="Disposition des écrans"><action name="Execute"><command>vesper-control-center schermi</command></action></item>
  </menu>

  <menu id="vesper-look" icon="@ICONE@/look.svg" label="Aspect">
    <item icon="@ICONE@/preset.svg" label="Préréglages (couleur, fond, icônes)"><action name="Execute"><command>vesper-profile</command></action></item>
    <item icon="@ICONE@/wallpaper.svg" label="Fond d'écran"><action name="Execute"><command>vesper-control-center sfondo</command></action></item>
    <item icon="@ICONE@/panel.svg" label="Habillage du panneau"><action name="Execute"><command>vesper-control-center aspetto</command></action></item>
  </menu>

  <menu id="root-menu" label="Vesper">
    <!-- intestazione: Openbox la disegna con lo stile "menu.title" del tema -->
    <separator label="Vesper"/>
    <item icon="@ICONE@/terminal.svg" label="Terminal"><action name="Execute"><command>vesper-terminal</command></action></item>
    <item icon="@ICONE@/files.svg" label="Gestionnaire de fichiers"><action name="Execute"><command>vesper-files</command></action></item>
    <separator/>
    <menu id="vesper-tools" icon="@ICONE@/tools.svg"/>
    <menu id="vesper-screen" icon="@ICONE@/screen.svg"/>
    <menu id="vesper-look" icon="@ICONE@/look.svg"/>
    <separator/>
    <item icon="@ICONE@/reload.svg" label="Recharger le gestionnaire de fenêtres"><action name="Reconfigure"/></item>
    <item icon="@ICONE@/reload.svg" label="Redémarrer le panneau"><action name="Execute"><command>vesper-panel-restart</command></action></item>
    <separator/>
    <item icon="@ICONE@/shutdown.svg" label="Déconnexion / Arrêt…"><action name="Execute"><command>vesper-logout</command></action></item>
  </menu>

</openbox_menu>
