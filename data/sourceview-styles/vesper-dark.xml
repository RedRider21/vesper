<?xml version="1.0" encoding="UTF-8"?>
<!--
  Schema di colore di Vesper per GtkSourceView (variante scura).
  SPDX-License-Identifier: AGPL-3.0-or-later
  Copyright (C) 2026 Daniele Deplano (RedRider21). Parte di Vesper.

  @ACCENT@ e le sue varianti sono segnaposto: vesper-editor riscrive lo schema
  in cache sostituendoli con l'accento del preset attivo.
-->
<style-scheme id="vesper-dark" _name="Vesper scuro" version="1.0">
  <author>Daniele Deplano (RedRider21)</author>
  <_description>Tema scuro di Vesper, intonato all'accento del preset</_description>

  <!-- tavolozza -->
  <color name="sfondo"    value="#070b12"/>
  <color name="riga"      value="#0d1622"/>
  <color name="bordo"     value="#17293a"/>
  <color name="testo"     value="#dff6ff"/>
  <color name="tenue"     value="#6f93a6"/>
  <color name="accento"   value="@ACCENT@"/>
  <color name="accento_s" value="@ACCENT_SCURO@"/>
  <color name="accento_c" value="@ACCENT_CHIARO@"/>
  <color name="verde"     value="#7ee787"/>
  <color name="giallo"    value="#ffd479"/>
  <color name="viola"     value="#c39bff"/>
  <color name="rosso"     value="#ff5a8a"/>
  <color name="arancio"   value="#ffa657"/>

  <!-- interfaccia della vista -->
  <style name="text"                        foreground="testo" background="sfondo"/>
  <style name="selection"                   foreground="sfondo" background="accento"/>
  <style name="selection-unfocused"         foreground="testo" background="bordo"/>
  <style name="cursor"                      foreground="accento"/>
  <style name="secondary-cursor"            foreground="accento_s"/>
  <style name="current-line"                background="riga"/>
  <style name="current-line-number"         foreground="accento" background="riga" bold="true"/>
  <style name="line-numbers"                foreground="tenue" background="riga"/>
  <style name="right-margin"                foreground="bordo" background="bordo"/>
  <style name="draw-spaces"                 foreground="bordo"/>
  <style name="background-pattern"          background="riga"/>
  <style name="bracket-match"               foreground="sfondo" background="accento" bold="true"/>
  <style name="bracket-mismatch"            foreground="#ffffff" background="rosso" bold="true"/>
  <style name="search-match"                foreground="sfondo" background="giallo"/>

  <!-- sintassi -->
  <style name="def:comment"                 foreground="tenue" italic="true"/>
  <style name="def:shebang"                 foreground="tenue" bold="true"/>
  <style name="def:doc-comment-element"     italic="true"/>
  <style name="def:constant"                foreground="accento_c"/>
  <style name="def:string"                  foreground="verde"/>
  <style name="def:special-char"            foreground="arancio"/>
  <style name="def:special-constant"        foreground="arancio" bold="true"/>
  <style name="def:number"                  foreground="arancio"/>
  <style name="def:floating-point"          foreground="arancio"/>
  <style name="def:identifier"              foreground="accento"/>
  <style name="def:function"                foreground="accento" bold="true"/>
  <style name="def:builtin"                 foreground="viola"/>
  <style name="def:statement"               foreground="viola" bold="true"/>
  <style name="def:keyword"                 foreground="viola" bold="true"/>
  <style name="def:operator"                foreground="testo"/>
  <style name="def:type"                    foreground="giallo"/>
  <style name="def:preprocessor"            foreground="arancio"/>
  <style name="def:error"                   foreground="rosso" bold="true" underline="error"/>
  <style name="def:warning"                 foreground="giallo" underline="single"/>
  <style name="def:note"                    foreground="sfondo" background="giallo" bold="true"/>
  <style name="def:underlined"              italic="true" underline="single"/>
  <style name="def:heading"                 foreground="accento" bold="true"/>
  <style name="def:link-destination"        foreground="accento_c" underline="single"/>
  <style name="def:deletion"                foreground="rosso"/>
  <style name="def:insertion"               foreground="verde"/>

  <!-- differenze e linguaggi con stili propri -->
  <style name="diff:added-line"             foreground="verde"/>
  <style name="diff:removed-line"           foreground="rosso"/>
  <style name="diff:changed-line"           foreground="giallo"/>
  <style name="diff:location"               foreground="accento" bold="true"/>
  <style name="xml:tag"                     foreground="accento"/>
  <style name="xml:attribute-name"          foreground="giallo"/>
  <style name="html:tag"                    foreground="accento"/>
  <style name="css:selector"                foreground="accento" bold="true"/>
  <style name="css:property-name"           foreground="giallo"/>
  <style name="python:builtin-function"     foreground="viola"/>
  <style name="python3:builtin-function"    foreground="viola"/>
  <style name="sh:function"                 foreground="accento" bold="true"/>
  <style name="sh:variable"                 foreground="accento_c"/>
  <style name="json:keyname"                foreground="accento"/>
  <style name="markdown:header"             foreground="accento" bold="true"/>
  <style name="markdown:code"               foreground="verde"/>
</style-scheme>
