# Vesper-Cards - tema Openbox stile macOS/iOS. Generato da
# tools/make-openbox-themes.py (placeholder #00e5ff = colore del preset,
# #00a4b7 = variante scura). NON modificare i temi generati a mano:
# modificare QUESTO template e rigenerare (python3 tools/make-openbox-themes.py).
#
# Look: barra scura "graphite" (i semafori si leggono bene con qualsiasi
# preset), tre pulsanti a SFERA a SINISTRA con il simbolo scavato dentro
# (rosso=chiudi, giallo=minimizza, verde=massimizza), coordinazione col preset
# su BORDO e TESTO del titolo. Gli angoli arrotondati li aggiunge picom (attivo
# solo con la famiglia Cards). I pulsanti a sinistra li imposta il titleLayout
# in rc.xml, gestito da vesper.profiles.model quando si sceglie Cards.
#
# Ispirato ad Arc-Dark-OSX (Dr-Noob / Dino Duratovic, GPL-3) per la tecnica dei
# colori per-pulsante; le maschere .xbm a sfera-con-simbolo sono originali
# Vesper (generate da tools/make-openbox-themes.py via PIL).
#
# NB: le sfere colorate usano i colori PER-PULSANTE di Openbox
# (window.active.button.<nome>.unpressed.image.color): il simbolo e' un FORO
# nella maschera .xbm, quindi appare nel colore della barra (button bg
# parentrelative).

# --- Geometria ---------------------------------------------------------------
padding.width: 8
padding.height: 6
border.width: 1
window.handle.width: 0
window.client.padding.width: 0
window.client.padding.height: 0

# --- Bordo: filo del colore del preset sull'attiva ------------------------------
window.active.border.color: #00e5ff
window.inactive.border.color: #2a2f37

# --- Barra del titolo: graphite neutro (contrasto per i semafori) ------------
window.active.title.bg: flat solid
window.active.title.bg.color: #2b2f38
window.inactive.title.bg: flat solid
window.inactive.title.bg.color: #23272e
window.active.label.bg: parentrelative
window.inactive.label.bg: parentrelative
# testo del titolo col colore del preset (tocco di coordinazione)
window.active.label.text.color: #00e5ff
window.inactive.label.text.color: #7f8792
window.label.text.justify: center
window.active.label.text.font:shadow=n
window.inactive.label.text.font:shadow=n

# --- Pulsanti a SFERA: colori semaforo per-pulsante --------------------------
# bg parentrelative: il foro del simbolo mostra la barra (graphite).
window.active.button.unpressed.bg: parentrelative
window.active.button.pressed.bg: parentrelative
window.active.button.hover.bg: parentrelative
window.active.button.disabled.bg: parentrelative
window.inactive.button.unpressed.bg: parentrelative
window.inactive.button.pressed.bg: parentrelative
window.inactive.button.hover.bg: parentrelative
window.inactive.button.disabled.bg: parentrelative

# chiudi = rosso, minimizza = giallo, massimizza = verde
window.active.button.close.unpressed.image.color: #ff5f57
window.active.button.iconify.unpressed.image.color: #febc2e
window.active.button.max.unpressed.image.color: #28c840
window.active.button.close.hover.image.color: #ff8079
window.active.button.iconify.hover.image.color: #ffd25f
window.active.button.max.hover.image.color: #57d76a
window.active.button.close.pressed.image.color: #d94b44
window.active.button.iconify.pressed.image.color: #d99e24
window.active.button.max.pressed.image.color: #1fa233
window.active.button.max.toggled.unpressed.image.color: #28c840
# inattiva: sfere spente (grigie) come su macOS
window.inactive.button.unpressed.image.color: #5a616c
window.inactive.button.hover.image.color: #7f8792
window.inactive.button.close.unpressed.image.color: #5a616c
window.inactive.button.iconify.unpressed.image.color: #5a616c
window.inactive.button.max.unpressed.image.color: #5a616c
window.active.button.disabled.image.color: #3a3f48
window.inactive.button.disabled.image.color: #33383f

# --- Menu: scuro con intestazione/voce attiva col colore del preset -------------
menu.border.color: #00e5ff
menu.border.width: 1
menu.title.bg: flat solid
menu.title.bg.color: #2b2f38
menu.title.text.color: #00e5ff
menu.title.text.justify: center
menu.items.bg: flat solid
menu.items.bg.color: #23272e
menu.items.text.color: #e6ebf2
menu.items.disabled.text.color: #5a6472
menu.items.active.bg: flat solid
menu.items.active.bg.color: #00e5ff
menu.items.active.text.color: #ffffff
menu.separator.color: #2a2f37
menu.items.justify: left

# --- OSD ---------------------------------------------------------------------
osd.border.width: 1
osd.border.color: #00e5ff
osd.bg: flat solid
osd.bg.color: #23272e
osd.label.text.color: #00e5ff
osd.hilight.bg: flat solid
osd.hilight.bg.color: #00e5ff
osd.unhilight.bg: flat solid
osd.unhilight.bg.color: #2a2f37
