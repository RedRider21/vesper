# Vesper-Core - tema finestre predefinito. Generato da
# tools/make-openbox-themes.py (#1a73e8 = colore del preset, #1252a7 =
# variante scura). NON modificare i temi generati: si cambia QUESTO template e
# si rigenera con  python3 tools/make-openbox-themes.py
#
# Look: barra del titolo PIATTA e compatta come nei desktop moderni (Mint,
# GNOME), titolo centrato, tre pulsanti completi a destra (minimizza,
# massimizza, chiudi) che si illuminano al passaggio del mouse; il chiudi
# diventa rosso. Cornice sottile, filetto d'accento sotto la barra della
# finestra attiva. Le maschere dei pulsanti sono glifi pieni generati da
# tools/make-button-masks.py: sono 12px e la barra è alta abbastanza da
# contenerli interi (maschere troppo grandi Openbox le RITAGLIA, e i pulsanti
# si vedono "a spicchi").

# --- Geometria: barra del titolo alta ~30px, cornice sottile ----------------
padding.width: 9
padding.height: 8
border.width: 1
window.client.padding.width: 0
window.client.padding.height: 0
window.handle.width: 0

# --- Cornice ----------------------------------------------------------------
window.active.border.color: #1252a7
window.inactive.border.color: #ccd6de

# --- Barra del titolo: piatta, con filetto d'accento sotto l'attiva ---------
window.active.title.bg: flat solid
window.active.title.bg.color: #e9eef3
window.inactive.title.bg: flat solid
window.inactive.title.bg.color: #e9eef3
window.active.title.separator.color: #1a73e8
window.inactive.title.separator.color: #ccd6de

# --- Testo del titolo: centrato, chiaro sull'attiva -------------------------
window.active.label.bg: parentrelative
window.inactive.label.bg: parentrelative
window.active.label.text.color: #0d1720
window.inactive.label.text.color: #5d6b76
window.label.text.justify: center
window.active.label.text.font:shadow=n
window.inactive.label.text.font:shadow=n

# --- Pulsanti: glifi completi, sfondo solo all'hover ------------------------
window.active.button.unpressed.bg: parentrelative
window.inactive.button.unpressed.bg: parentrelative
window.active.button.disabled.bg: parentrelative
window.inactive.button.disabled.bg: parentrelative
window.active.button.hover.bg: flat solid
window.active.button.hover.bg.color: #dce6ed
window.active.button.pressed.bg: flat solid
window.active.button.pressed.bg.color: #1252a7

window.active.button.unpressed.image.color: #17242e
window.inactive.button.unpressed.image.color: #9aa7b1
window.active.button.hover.image.color: #1a73e8
window.inactive.button.hover.image.color: #17242e
window.active.button.pressed.image.color: #ffffff
window.active.button.disabled.image.color: #b9c6d0
window.inactive.button.disabled.image.color: #c6d1d9

# Il pulsante CHIUDI si accende di rosso sotto il mouse, come ci si aspetta.
window.active.button.close.hover.bg: flat solid
window.active.button.close.hover.bg.color: #ffd9e1
window.active.button.close.hover.image.color: #7a2038
window.active.button.close.pressed.bg: flat solid
window.active.button.close.pressed.bg.color: #ff5a8a
window.active.button.close.pressed.image.color: #ffffff

# --- Menu del window manager -----------------------------------------------
menu.border.width: 1
menu.border.color: #ccd6de
menu.title.bg: flat solid
menu.title.bg.color: #e9eef3
menu.title.text.color: #1a73e8
menu.title.text.justify: center
menu.items.bg: flat solid
menu.items.bg.color: #e9eef3
menu.items.text.color: #17242e
menu.items.disabled.text.color: #9aa7b1
menu.items.active.bg: flat solid
menu.items.active.bg.color: #1252a7
menu.items.active.text.color: #0d1720
menu.separator.color: #ccd6de
menu.separator.width: 1
menu.overlap.x: -2

# --- OSD (indicatori a schermo) --------------------------------------------
osd.border.width: 1
osd.border.color: #ccd6de
osd.bg: flat solid
osd.bg.color: #e9eef3
osd.label.text.color: #1a73e8
osd.hilight.bg: flat solid
osd.hilight.bg.color: #1a73e8
osd.unhilight.bg: flat solid
osd.unhilight.bg.color: #ccd6de
