! vim:enc=utf-8:nu:ai:si:et:ts=4:sw=4:ft=xdefaults:

!! 1977 - A minimalist theme set for Openbox
!! Author:  Thayer Williams (thayerw@gmail.com)
!! Website: http://cinderwick.ca
!!
!! Adattato per Vesper (famiglia Retro): rispetto all'originale le finestre
!! INATTIVE hanno una barra smorzata col titolo leggibile (nel 1977 sparivano
!! titolo e pulsanti) e testo/pulsanti dell'attiva scuri sugli accenti chiari.


!! osd
osd.border.width: 4
osd.hilight.bg: solid flat
osd.hilight.bg.color: #424242
osd.unhilight.bg: solid flat
osd.unhilight.bg.color: #ffffff
osd.label.text.color: #ffffff


!! menus
menu.title.bg: flat
menu.title.bg.color: #ffe14b
menu.title.text.color: #10161c
menu.title.text.justify: right

menu.items.bg: flat solid
menu.items.bg.color: #ffffff
menu.items.bg.border.color: #bbb8a9
menu.items.text.color: #81807c
menu.items.justify: left

menu.items.disabled.text.color: #d7d7d7
menu.bullet.image.color: #ffe14b
menu.bullet.selected.image.color: #ffffff

menu.items.active.bg: flat border
menu.items.active.bg.color: #424242
menu.items.active.bg.border.color: #424242
menu.items.active.text.color: white
# Spazio tra le voci: Openbox 3.6 non ha un padding per voce (menuframe.c:
# altezza = font + |ombra| + 4, fissi). Un'ombra del testo INVISIBILE
# (shadowtint=0 = trasparenza 0) aggiunge 5px a ogni voce, col testo centrato.
menu.items.font: shadow=y:shadowoffset=5:shadowtint=0
# Separatori del menu con margini (coerente con Vesper-Core)
menu.separator.width: 1
menu.separator.padding.width: 10
menu.separator.padding.height: 4
# Bordo spesso nel tono del fondo = margine interno uniforme del menu
menu.border.width: 6
menu.border.color: #efefec

!! fonts
window.active.label.text.font:shadow=y
window.inactive.label.text.font:shadow=n
menu.title.text.font:shadow=n

!! misc
border.color: #ffe14b
borderWidth: 2
padding.width: 3
window.handle.width: 2
window.client.padding.width: 0
window.label.text.justify: left

!! windows focused
window.active.client.color: #909498

window.active.title.bg: focus: flat
window.active.title.bg.color: #ffe14b
window.active.title.bg.border.color: #ffffff

window.active.handle.bg: flat
window.active.handle.bg.color: #ffe14b
window.active.grip.bg: flat
window.active.grip.bg.color: #ffe14b

window.active.label.bg: parentrelative
window.active.label.text.color: #10161c

window.active.button.unpressed.bg: flat
window.active.button.unpressed.bg.color: #ffe14b
window.active.button.unpressed.image.color: #10161c

window.active.button.pressed.bg: flat
window.active.button.pressed.bg.color: #ffe14b
window.active.button.pressed.image.color: #000000

!! windows unfocused
window.inactive.client.color: #404850

window.inactive.title.bg: flat
window.inactive.title.bg.color: #eae3c0

window.inactive.handle.bg: flat
window.inactive.handle.bg.color: #eae3c0

window.inactive.grip.bg: flat
window.inactive.grip.bg.color: #eae3c0

window.inactive.label.bg: parentrelative
window.inactive.label.text.color: #5f656b

window.inactive.button.unpressed.bg: flat
window.inactive.button.unpressed.bg.color: #eae3c0
window.inactive.button.unpressed.image.color: #5f656b

window.inactive.button.pressed.bg: flat 
window.inactive.button.pressed.bg.color: #eae3c0

window.inactive.button.hover.image.color: #b7a236

!! buttons
window.active.button.disabled.bg: flat 
window.active.button.disabled.bg.color: #ffe14b

window.inactive.button.disabled.bg: flat 
window.inactive.button.disabled.bg.color: #eae3c0
window.inactive.button.disabled.image.color: #5f656b

window.active.button.toggled.bg: flat
window.active.button.toggled.bg.color: #ffe14b
window.active.button.toggled.image.color: #10161c

window.inactive.button.toggled.bg: flat
window.inactive.button.toggled.bg.color: #eae3c0
window.inactive.button.toggled.image.color: #5f656b

